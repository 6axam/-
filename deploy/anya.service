[Unit]
Description=Anya Telegram companion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anya
WorkingDirectory=/opt/anya
EnvironmentFile=/opt/anya/.env
ExecStart=/opt/anya/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
