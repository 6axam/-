TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Leave empty to use the provider default. For OpenRouter it is
# https://openrouter.ai/api/v1.
LLM_BASE_URL=
# Optional. Leave empty to keep the selected model's default; valid range 0.0–2.0.
LLM_TEMPERATURE=
CONTEXT_RECENT_MAX_MESSAGES=24
CONTEXT_RECENT_TOKEN_BUDGET=1500
# Soft telemetry warning only; immutable prompts are not trimmed automatically.
CONTEXT_TARGET_INPUT_TOKENS=5600
# Compact relevant long-term memories only; no embeddings/vector DB are used.
MEMORY_CONTEXT_TOKEN_BUDGET=380
MEMORY_CONTEXT_MAX_ITEMS=6
DATABASE_URL=sqlite:///data/companion.db
DEBOUNCE_SECONDS=2.0
MESSAGE_SPLIT_ENABLED=true
MESSAGE_SPLIT_TARGET_CHARS=70
MESSAGE_SPLIT_MIN_CHARS=25
MESSAGE_SPLIT_MAX_PARTS=4
INITIATIVE_ENABLED=true
INITIATIVE_CHECK_INTERVAL_MINUTES=15
INITIATIVE_MIN_IDLE_MINUTES=45
INITIATIVE_COOLDOWN_HOURS=4
INITIATIVE_MAX_PER_DAY=3
INITIATIVE_MAX_UNANSWERED=1
CONVERSATION_COOLING_MINUTES=30
CONVERSATION_ENDED_HOURS=12
LLM_SUPPORTS_VISION=true
LLM_SUPPORTS_MULTIPLE_IMAGES=true
MEDIA_CACHE_DIR=data/media-cache
MEDIA_CACHE_MAX_AGE_DAYS=14
MAX_IMAGE_BYTES=8388608
MAX_STICKER_BYTES=2097152
MAX_ANIMATION_BYTES=8388608
STICKER_ANALYSIS_ENABLED=true
STICKER_ANALYSIS_WORKERS=1
STICKER_ANALYSIS_MAX_FRAMES=5
STICKER_ANALYSIS_RETRY_LIMIT=3
STICKER_ANALYSIS_VERSION=v1
STICKER_CURRENT_ANALYSIS_TIMEOUT_SECONDS=2.0
STICKER_SELECTION_STRATEGY=ranked
STICKER_EMBEDDING_PROVIDER=local
STICKER_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
STICKER_EMBEDDING_DEVICE=cpu
STICKER_REPEAT_WINDOW_HOURS=24
STICKER_REPEAT_STRONG_WINDOW_MINUTES=30
RECENT_MEDIA_CONTEXT_HOURS=24
TIMEZONE=Europe/Kyiv
SLEEP_START_HOUR=1
WAKE_HOUR=7
# Local college/travel window. Outside it, delayed normal replies require a
# real persisted busy/away daily event.
COLLEGE_START_HOUR=8
COLLEGE_END_HOUR=15
# Monday=0 … Sunday=6. Weekends are free by default.
COLLEGE_WEEKDAYS=0,1,2,3,4
COLLEGE_NORMAL_DELAY_MULTIPLIER=1.5
COLLEGE_ACTIVE_DELAY_CAP_SECONDS=30
# Image intent schema and queue support are enabled; leave provider disabled until one is configured.
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_DAILY_LIMIT=2
IMAGE_GENERATION_COOLDOWN_HOURS=12
IMAGE_GENERATION_PROVIDER=openrouter
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=https://openrouter.ai/api/v1
ANYA_REFERENCE_IMAGE=assets/anya/reference.jpg
IMAGE_PROMPT_DEBUG=false
DAILY_LIFE_ENABLED=true
DAILY_LIFE_CHECK_INTERVAL_MINUTES=30
WEATHER_ENABLED=true
# Kyiv by default. Set coordinates for Anya's actual city.
WEATHER_LATITUDE=50.4501
WEATHER_LONGITUDE=30.5234
WEATHER_CACHE_MINUTES=20
